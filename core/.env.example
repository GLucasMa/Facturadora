# Copiá este archivo como `.env` (en esta misma carpeta) y completá los valores.
# El archivo `.env` no se sube al repositorio.

# --- Base de datos (MySQL) ---
DB_NAME=facturacion_arca
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Modo desarrollo ---
# True en tu máquina. En un servidor: False (o borrar la línea).
DEBUG=True

# True: facturas con CAE ficticio, sin conexión a ARCA. False: ARCA real.
MODO_SIMULACION=True

# --- Solo para publicar en un servidor (con DEBUG=False) ---
# Clave secreta propia. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# SECRET_KEY=
# Dominios del backend, separados por coma.
# ALLOWED_HOSTS=midominio.com.ar,www.midominio.com.ar
# Direcciones del frontend que pueden usar la API, separadas por coma.
# CORS_ALLOWED_ORIGINS=https://midominio.com.ar
